    "note_tweet": {
      "entities": {
        "urls": [
          {
            "display_url": "doj.gov.hk/tc/notable_jud…",
            "end": 131,
            "expanded_url": "https://www.doj.gov.hk/tc/notable_judgments/pdf/FACV_8_9_2022c.pdf",
